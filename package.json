{
  "name": "sigm-quinua-frontend",
  "version": "1.0.0",
  "description": "Frontend tooling para SIGM-QUINUA con Tailwind CSS y Lucide Icons",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/main/resources/css/input.css -o ./src/main/resources/static/css/tailwind.min.css --minify",
    "watch:css": "tailwindcss -i ./src/main/resources/css/input.css -o ./src/main/resources/static/css/tailwind.min.css --watch"
  },
  "devDependencies": {
    "lucide": "^1.16.0",
    "tailwindcss": "^3.4.17"
  }
}